{
  "name": "cinebook-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/main.js",
    "build": "node --input-type=module -e \"import { cpSync, rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true }); cpSync('src', 'dist', { recursive: true });\"",
    "prestart": "npm run build",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "firebase-admin": "^13.0.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
