{
  "name": "cinebook-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prestart": "sh -c 'PIDS=$(lsof -tiTCP:3000 -sTCP:LISTEN 2>/dev/null); [ -z \"$PIDS\" ] || kill $PIDS'",
    "dev": "node src/main.js",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('src','dist',{recursive:true});\"",
    "start": "node dist/main.js",
    "stop": "sh -c 'PIDS=$(lsof -tiTCP:3000 -sTCP:LISTEN 2>/dev/null); [ -z \"$PIDS\" ] || kill $PIDS'"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "dotenv": "^17.2.1",
    "firebase-admin": "^13.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  }
}
